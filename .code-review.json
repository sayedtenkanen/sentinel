{
    "exclude": [
        "tests/",
        "sentinel/test/",
        "_assets/"
    ],
    "suppress": [
        {"rule": "SEC003", "pattern": "**/context.py"},
        {"rule": "SEC004", "pattern": "**/context.py"},
        {"rule": "SEC028", "pattern": "*"},
        {"rule": "ST003", "pattern": "**/dashboard.py"},
        {"rule": "ST003", "pattern": "**/registry.py"},
        {"rule": "ST005", "pattern": "*"},
        {"rule": "ST009", "pattern": "**/context_hub.py"},
        {"rule": "DOC006", "pattern": "*"},
        {"rule": "ST001", "pattern": "**/dashboard.py"}
    ],
    "agents": {
        "static-analysis": {
            "complexity_threshold": 80,
            "max_function_length": 80,
            "max_line_length": 120,
            "max_nesting_depth": 8,
            "max_params": 12
        },
        "architecture": {
            "god_module_threshold": 10
        },
        "refactor": {
            "complexity_weight": 2.0,
            "length_weight": 1.0,
            "param_weight": 1.5,
            "refactor_threshold": 20.0
        }
    },
    "output": {
        "format": "markdown",
        "verbose": false
    }
}
